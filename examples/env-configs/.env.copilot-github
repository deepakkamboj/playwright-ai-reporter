# =============================================================================
# GITHUB COPILOT + GITHUB ISSUES (no stored model API key)
# Failure -> AI root cause -> GitHub issue -> fix PR -> green run closes the issue
#
# Use in GitHub Actions with:
#   permissions: { contents: read, issues: write, copilot-requests: write }
#   - run: npm install --global @github/copilot
# and the reporter options: generateFix, createBug, closeFixedBugs (not on pull request runs).
# =============================================================================

# AI Provider Configuration: runs the GitHub Copilot CLI with every tool disabled
AI_PROVIDER=copilot

# In GitHub Actions the workflow token authenticates both Copilot and GitHub Issues:
#   GITHUB_TOKEN: ${{ github.token }}
# Locally, leave GITHUB_TOKEN unset to use your Copilot CLI login, or set a fine-grained PAT
# with the "Copilot Requests" permission (and Issues read/write for the bug tracker).
# GITHUB_TOKEN=

# Optional Copilot settings
# COPILOT_MODEL=
# COPILOT_CLI_PATH=copilot
# A call can take over a minute; the default timeout is 5 minutes
# COPILOT_TIMEOUT_MS=300000

# Bug Tracker Configuration
BUG_TRACKER_PROVIDER=github
GITHUB_OWNER=your-org-or-user
GITHUB_REPO=your-repo

# PR Provider Configuration - DISABLED (enable only after reviewing the safety checks in the README)
# PR_PROVIDER=github
