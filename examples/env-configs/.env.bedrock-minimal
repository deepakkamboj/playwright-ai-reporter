# =============================================================================
# MINIMAL CONFIGURATION (AWS Bedrock)
# This configuration uses: AWS Bedrock (via the Converse API) + Local SQLite
# No bug tracking, no PRs, no notifications - just AI analysis and logging
# =============================================================================

# AI Provider Configuration
# Supported providers: azure-openai, openai, anthropic, google, mistral, bedrock
AI_PROVIDER=bedrock

# AWS Bedrock Configuration
# Credentials are resolved via the standard AWS SDK provider chain:
# environment variables (below), shared credentials file, or an attached IAM role.
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-session-token  # Only required for temporary credentials

# Database Configuration
# Supported providers: sqlite, mysql, postgresql
DATABASE_PROVIDER=sqlite

# SQLite Configuration (local file-based database)
SQLITE_DATABASE_PATH=./data/test-results.db

# Bug Tracker Configuration - DISABLED
# BUG_TRACKER_PROVIDER=

# Notification Configuration - DISABLED
# NOTIFICATION_PROVIDER=

# PR Provider Configuration - DISABLED
# PR_PROVIDER=

# Feature Flags
ENABLE_BUG_CREATION=false
ENABLE_PR_CREATION=false
ENABLE_DATABASE_LOGGING=true
ENABLE_NOTIFICATIONS=false

# Test Environment Metadata
TEST_ENVIRONMENT=local
BRANCH_NAME=feature/my-branch
COMMIT_HASH=
